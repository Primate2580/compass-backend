# Copy this file to ".env" and fill in the values.
# Never commit .env to GitHub.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
PORT=3000

# Which AI to use: "gemini" (has a free tier) or "anthropic" (paid)
AI_PROVIDER=gemini

# --- Gemini (free key from aistudio.google.com) ---
GEMINI_API_KEY=your-gemini-key-here
# Optional: Google retires models often. If you get "model not found", pick a current Flash or Flash-Lite
# model from the models list in Google AI Studio and put its exact ID here.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Anthropic / Claude (paid; only needed if AI_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5
